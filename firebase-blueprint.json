{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered clan member profile with permissions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "scout", "member"] },
        "clanName": { "type": "string" },
        "discordTag": { "type": "string" },
        "createdAt": { "type": "number" },
        "lastActiveAt": { "type": "number" }
      },
      "required": ["id", "username", "role"]
    },
    "Presence": {
      "title": "Presence",
      "description": "Online logged-in spectator presence on the tribune",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "nickname": { "type": "string" },
        "className": { "type": "string" },
        "level": { "type": "number" },
        "clanName": { "type": "string" },
        "role": { "type": "string" },
        "lastSeen": { "type": "number" }
      },
      "required": ["userId", "nickname", "lastSeen"]
    },
    "BossState": {
      "title": "BossState",
      "description": "Boss respawn tracking status and timer data",
      "type": "object",
      "properties": {
        "bossId": { "type": "string" },
        "phase": { "type": "string" },
        "timeOfDeath": { "type": "string" },
        "timeOfDeathTimestamp": { "type": "number" },
        "selectedAccountId": { "type": "string" },
        "selectedCharacterName": { "type": "string" },
        "selectedCamCode": { "type": "string" }
      },
      "required": ["bossId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Clan members collection"
    },
    "/presence/{userId}": {
      "schema": "Presence",
      "description": "Online logged-in spectators on the tribune"
    },
    "/tracker/{docId}": {
      "schema": "BossState",
      "description": "Shared boss tracker state and active alerts"
    }
  }
}
