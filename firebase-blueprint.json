{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered clan member profile and auth data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "displayName": { "type": "string" },
        "passwordHash": { "type": "string" },
        "salt": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "scout", "member"] },
        "clanName": { "type": "string" },
        "discordTag": { "type": "string" },
        "characters": { "type": "string" },
        "activeCharacterId": { "type": "string" },
        "createdAt": { "type": "number" },
        "lastActiveAt": { "type": "number" }
      },
      "required": ["id", "username", "role"]
    },
    "UserSession": {
      "title": "UserSession",
      "description": "Active user auth token session",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "token": { "type": "string" },
        "expiresAt": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "token", "expiresAt"]
    },
    "BossStateCollection": {
      "title": "BossStateCollection",
      "description": "Global synchronized boss tracker state, spotters, and spectators",
      "type": "object",
      "properties": {
        "bosses": { "type": "string" },
        "spectators": { "type": "string" },
        "accountOccupancies": { "type": "string" },
        "customAccounts": { "type": "string" },
        "spawnAlertLogs": { "type": "string" },
        "lastUpdated": { "type": "number" }
      },
      "required": ["lastUpdated"]
    },
    "LfgStateCollection": {
      "title": "LfgStateCollection",
      "description": "Active party queue and groups state",
      "type": "object",
      "properties": {
        "queuePlayers": { "type": "string" },
        "activeGroups": { "type": "string" },
        "lastUpdated": { "type": "number" }
      },
      "required": ["lastUpdated"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Clan members collection"
    },
    "/sessions/{sessionId}": {
      "schema": "UserSession",
      "description": "Active login sessions"
    },
    "/tracker/{docId}": {
      "schema": "BossStateCollection",
      "description": "Epic boss tracker live sync state"
    },
    "/lfg/{docId}": {
      "schema": "LfgStateCollection",
      "description": "LFG parties and queue sync state"
    }
  }
}

